{
  "name": "marionette",
  "private": true,
  "license": "MIT",
  "workspaces": [
    "apps/*",
    "packages/*",
    "modules/*"
  ],
  "scripts": {
    "dev:backend": "npm --workspace @marionette/backend run dev",
    "dev:viewer": "npm --workspace @marionette/viewer run dev",
    "test": "npm run test --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "npm --workspace @marionette/mobile run lint"
  }
}
