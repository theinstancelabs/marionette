{
  "name": "@marionette/kit",
  "version": "0.1.0",
  "private": true,
  "description": "Reusable parts for Marionette phone screens: a classic script, a stylesheet and types, with no build.",
  "files": [
    "marionette-kit.js",
    "marionette-kit.css",
    "marionette-kit.d.ts"
  ],
  "types": "marionette-kit.d.ts",
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "inline": "node scripts/inline.mjs"
  },
  "devDependencies": {
    "@marionette/protocol": "file:../protocol",
    "jsdom": "^25.0.1",
    "typescript": "^5.6.3",
    "vitest": "^2.1.8"
  }
}
