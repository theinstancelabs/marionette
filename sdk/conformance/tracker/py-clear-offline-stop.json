{
 "name": "Clearing an offline phone's Stop (Python)",
 "description": "clear_stale_stops() also clears Stop on offline phones of this gateway, which can't clear it themselves, until they come back.",
 "options": {
  "mirror": "stop-only",
  "stop_action": "safety.estop"
 },
 "steps": [
  {
   "message": {
    "type": "config",
    "version": 1,
    "sessionId": "marionette-py00001",
    "serverName": "Python fixtures",
    "controls": [
     {
      "id": "deadman",
      "type": "button",
      "label": "Hold to move",
      "action": "teleop.deadman",
      "hold": true,
      "held": false
     },
     {
      "id": "turn-left",
      "type": "button",
      "label": "Turn left",
      "action": "base.turnLeft",
      "hold": true,
      "held": false
     },
     {
      "id": "estop",
      "type": "toggle",
      "label": "Stop",
      "action": "safety.estop",
      "value": true
     },
     {
      "id": "arm",
      "type": "select",
      "label": "Arm",
      "action": "arm.select",
      "value": "left",
      "options": [
       {
        "label": "Left arm",
        "value": "left"
       },
       {
        "label": "Right arm",
        "value": "right"
       }
      ]
     },
     {
      "id": "scale",
      "type": "slider",
      "label": "Motion scale",
      "action": "teleop.translationScale",
      "value": 1,
      "min": 0.1,
      "max": 4,
      "step": 0.1,
      "unit": "×",
      "live": false
     },
     {
      "id": "drive",
      "type": "joystick",
      "label": "Drive",
      "action": "base.drive",
      "value": {
       "x": 0,
       "y": 0
      },
      "live": false
     },
     {
      "id": "reset-left",
      "type": "button",
      "label": "Reset left arm",
      "action": "arm.resetLeft"
     },
     {
      "id": "calibration-start",
      "type": "button",
      "label": "Start calibration",
      "action": "calibration.start"
     }
    ],
    "cameraStreams": [],
    "cameraViews": [],
    "calibration": {
     "status": "uncalibrated",
     "epoch": 0
    },
    "phones": [
     {
      "id": "phone-1",
      "name": "Phone 1",
      "color": "#c98200",
      "connected": true
     }
    ],
    "robots": [],
    "gatewayId": "gw-test",
    "auth": false,
    "phone": {
     "id": "phone-1",
     "name": "Phone 1",
     "color": "#c98200",
     "connected": true
    }
   }
  },
  {
   "note": "a tracker that starts late learns Stop from the config",
   "expect": {
    "phones": {
     "phone-1": {
      "stop": true
     }
    },
    "any_stop": true
